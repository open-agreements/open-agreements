{
  "groups": [
    {
      "id": "convertible_securities_section",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^Defined Terms Used in this Agreement"],
      "options": [
        {
          "label": "Include convertible securities conversion section",
          "marker": "Conversion and Termination of Convertible Securities",
          "trigger": { "field": "include_convertible_securities", "equals": true }
        }
      ]
    },
    {
      "id": "milestones_definition",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^\u201cOfficer\u201d means"],
      "options": [
        {
          "label": "Include milestones definition",
          "marker": "\u201cMilestones\u201d means the milestones set forth on Annex 1",
          "trigger": { "field": "include_tranche_closing", "equals": true }
        }
      ]
    },
    {
      "id": "tranche_closing_condition_definition",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^\u201cTranche Closing Date\u201d means"],
      "options": [
        {
          "label": "Include tranche closing condition definition",
          "marker": "\u201cTranche Closing Condition\u201d means",
          "trigger": { "field": "include_tranche_closing", "equals": true }
        }
      ]
    },
    {
      "id": "tranche_closing_date_definition",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^\u201cTransaction Agreements\u201d means"],
      "options": [
        {
          "label": "Include tranche closing date definition",
          "marker": "\u201cTranche Closing Date\u201d means",
          "trigger": { "field": "include_tranche_closing", "equals": true }
        }
      ]
    },
    {
      "id": "mandatory_tranche_schedule",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^EXHIBIT A-1"],
      "options": [
        {
          "label": "Include mandatory tranche schedule",
          "marker": "Alternative if there is a mandatory tranche closing",
          "trigger": { "field": "include_tranche_closing", "equals": true },
          "removal": {
            "kind": "table",
            "anchor": "Tranche Closing Shares"
          }
        }
      ]
    },
    {
      "id": "tranche_closing_section",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "options": [
        {
          "label": "Include tranche, elective, shortfall, and mandatory-conversion provisions",
          "marker": "Tranche Closing",
          "trigger": { "field": "include_tranche_closing", "equals": true },
          "removal": {
            "kind": "section",
            "startAnchor": "[Tranche Closing.",
            "endAnchor": "Closing Deliverables.  At {closing_article} Closing, the Company shall deliver to each Purchaser a certificate representing the Shares being purchased by such Purchaser at such Closing against payment of the purchase price therefor by check payable to the Company, by wire transfer to a bank account designated by the Company, by cancellation or conversion of indebtedness or other convertible securities of the Company to Purchaser[, including interest], or by any combination of such methods."
          }
        }
      ]
    },
    {
      "id": "small_business_concern_representation",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^\\[?Foreign Corrupt Practices Act"],
      "options": [
        {
          "label": "Include SBIC small-business representation",
          "marker": "Small Business Concern",
          "trigger": { "field": "include_sbic_representation", "equals": true },
          "removal": { "kind": "section", "startAnchor": "[Small Business Concern", "endAnchor": "[Foreign Corrupt Practices Act" }
        }
      ]
    },
    {
      "id": "sba_matters_heading",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "options": [
        {
          "label": "Include SBA Matters closing-condition heading",
          "marker": "SBA Matters",
          "trigger": { "field": "include_sbic_representation", "equals": true },
          "removal": { "kind": "paragraph", "anchor": "[SBA Matters", "match": "exact", "expectedMatches": 1 }
        }
      ]
    },
    {
      "id": "sba_matters_condition",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "options": [
        {
          "label": "Include SBA Matters closing condition",
          "marker": "SBIC Purchaser",
          "trigger": { "field": "include_sbic_representation", "equals": true },
          "removal": { "kind": "paragraph", "anchor": ". The Company shall have executed and delivered to each SBIC Purchaser a Size Status Declaration on SBA Form 480 and an Assurance of Compliance on SBA Form 652, and shall have provided to each such Purchaser information necessary for the preparation of a Portfolio Financing Report on SBA Form 1031.]", "match": "exact", "expectedMatches": 1 }
        }
      ]
    },
    {
      "id": "healthcare_representations",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^\\[?CFIUS Representations"],
      "options": [
        {
          "label": "Include Healthcare Laws representation",
          "marker": "Healthcare Laws",
          "trigger": { "field": "include_healthcare_representations", "equals": true },
          "removal": { "kind": "section", "startAnchor": "[Healthcare Laws", "endAnchor": "CFIUS Representations" }
        }
      ]
    },
    {
      "id": "dispute_resolution",
      "type": "radio",
      "markerless": true,
      "subClauseStopPatterns": ["^Each of the parties", "^Waiver of Jury Trial"],
      "options": [
        {
          "label": "Arbitration",
          "marker": "shall be resolved by arbitration before a single arbitrator",
          "trigger": { "field": "dispute_resolution_mode", "equals": "arbitration" }
        },
        {
          "label": "Courts",
          "marker": "hereby irrevocably and unconditionally submit to the jurisdiction of the state courts of",
          "trigger": "default"
        }
      ]
    },
    {
      "id": "additional_closings",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "subClauseStopPatterns": ["^Closing Deliverables", "^Defined Terms"],
      "options": [
        {
          "marker": "Additional Closings",
          "trigger": { "field": "closing_type", "equals": "additional" },
          "replaceWith": ""
        }
      ]
    },
    {
      "id": "convertible_payment_method",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "inline": true,
      "options": [
        {
          "label": "Permit payment through convertible securities",
          "marker": ", by cancellation or conversion of indebtedness or other convertible securities of the Company to Purchaser[, including interest]",
          "trigger": { "field": "include_convertible_securities", "equals": true },
          "replaceWith": ", by cancellation or conversion of indebtedness or other convertible securities of the Company to Purchaser, including interest"
        }
      ]
    },
    {
      "id": "tranche_closing_clause",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "inline": true,
      "options": [
        {
          "label": "Include tranche closing shares", "marker": ", [Each Purchaser at the Initial Closing shall be obligated to purchase that number of Tranche Closing Shares (as defined below) as is set forth opposite such Purchaser's name on Exhibit A under the heading \"Tranche Closing Shares\" (as to any Purchaser, its \"Tranche Closing Shares\"), as provided in Section [1.2(c)] below.]",
          "trigger": { "field": "include_tranche_closing", "equals": true },
          "replaceWith": ""
        }
      ]
    },
    {
      "id": "convertible_securities_clause",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "inline": true,
      "options": [
        {
          "label": "Include convertible securities", "marker": "[or, as applicable, a purchase price of ${convertible_purchase_price_per_share} per share with respect to the shares of Series {convertible_series_designation} Preferred Stock being issued [in the Initial Closing] pursuant to any cancellation or conversion of Convertible Securities (as defined below) as set forth in Section 1.3 below]",
          "trigger": { "field": "include_convertible_securities", "equals": true },
          "replaceWith": ""
        },
        {
          "label": "Include convertible securities capitalization rep", "marker": "[The Company has issued Convertible Securities that will convert into an aggregate of {convertible_security_shares} shares of Series {convertible_series_designation} Preferred Stock as of the {initial_word_title}Closing as set forth under the column heading \"Convertible Security Shares\" on Exhibit A and Exhibit A-1.]",
          "trigger": { "field": "include_convertible_securities", "equals": true },
          "replaceWith": ""
        }
      ]
    },
    {
      "id": "closing_reference_bracket",
      "type": "checkbox",
      "standalone": true,
      "markerless": true,
      "inline": true,
      "options": [
        {
          "label": "Include closing reference", "marker": "[with respect to such Closing]",
          "trigger": { "field": "include_closing_reference", "equals": true },
          "replaceWith": ""
        }
      ]
    },
    {
      "id": "hipaa_representation",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"label":"HIPAA representation","marker":"protected health information, as defined under 45 C.F.R. § 160.103","trigger":{"field":"include_healthcare_representations","equals":true},"removal":{"kind":"paragraph","anchor":"protected health information, as defined under 45 C.F.R. § 160.103","match":"contains","expectedMatches":1}}]
    },
    {
      "id": "preclinical_representation",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"marker":"Preclinical Development and Clinical Trials","trigger":{"field":"include_healthcare_representations","equals":true},"removal":{"kind":"paragraph","anchor":"Preclinical Development and Clinical Trials","match":"contains","expectedMatches":1}}]
    },
    {
      "id": "fda_representation",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"marker":"FDA Application Integrity Policy","trigger":{"field":"include_healthcare_representations","equals":true},"removal":{"kind":"paragraph","anchor":"FDA Application Integrity Policy","match":"contains","expectedMatches":1}}]
    },
    {
      "id": "fda_heading",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"marker":"FDA Approvals","trigger":{"field":"include_healthcare_representations","equals":true},"removal":{"kind":"paragraph","anchor":"[FDA Approvals","match":"exact","expectedMatches":1}}]
    },
    {
      "id": "telecom_representation",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"marker":"Federal Communications Commission","trigger":{"field":"include_telecom_representation","equals":true},"removal":{"kind":"paragraph","anchor":"Federal Communications Commission","match":"contains","expectedMatches":1}}]
    },
    {
      "id": "telecom_heading",
      "type": "checkbox", "standalone": true, "markerless": true,
      "options": [{"marker":"FCC Regulation and Compliance","trigger":{"field":"include_telecom_representation","equals":true},"removal":{"kind":"paragraph","anchor":"[FCC Regulation and Compliance","match":"exact","expectedMatches":1}}]
    },
    {"id":"ira_other_stockholders_definition","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Other IRA stockholders definition","marker":"[and certain other stockholders of the Company]","trigger":{"field":"include_other_ira_stockholders","equals":true},"replaceWith":""}]},
    {"id":"requisite_purchasers_majority","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Requisite Purchasers majority threshold","marker":"[a majority]","trigger":{"field":"requisite_purchaser_standard","equals":"majority"},"replaceWith":""}]},
    {"id":"subsidiary_section_refs","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Subsidiary representation references","marker":"[, 2.21, 2.22, 2.23, 2.24]","trigger":{"field":"include_subsidiary_carve_ins","equals":true},"replaceWith":""},{"label":"Subsidiary disclosure reference","marker":" [and the second to last sentence of Section 2.25]","trigger":{"field":"include_subsidiary_carve_ins","equals":true},"replaceWith":""}]},
    {"id":"authorization_timing","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Pre-closing authorization timing","marker":"[ or will be taken prior to the {applicable_word} Closing]","trigger":{"field":"authorization_actions_timing","equals":"prior_to_closing"},"replaceWith":""}]},
    {"id":"patent_knowledge","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Patent and trademark knowledge qualifier","marker":"[with respect to patents and trademarks]","trigger":{"field":"include_patent_trademark_knowledge_qualifier","equals":true},"replaceWith":""}]},
    {"id":"subsequent_closing_condition","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Subsequent Closing purchaser condition","marker":"[or any subsequent Closing]","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":""},{"label":"Subsequent Closing company condition","marker":" or any subsequent Closing","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":""}]},
    {"id":"subsequent_closing_rep","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Subsequent Closing representation","marker":"[and, as to any subsequent Closing, in all material respects as of such subsequent Closing]","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":""}]},
    {"id":"subsequent_closing_covenant","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Subsequent Closing covenant","marker":"[and, as to any subsequent Closing, in all material respects on or before such subsequent Closing]","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":""}]},
    {"id":"subsequent_closing_termination","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Subsequent Closing termination","marker":"[or any subsequent Closing, as the case may be,]","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":""}]},
    {"id":"tranche_transfer_restriction","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Tranche transfer restriction","marker":" Notwithstanding anything herein to the contrary, no Shares may be transferred prior to the consummation or termination of the obligation to consummate the Tranche Closing unless all rights and obligations hereunder (including without limitation the obligations to consummate the Tranche Closing) are assigned to and assumed by the transferee.","trigger":{"field":"include_tranche_closing","equals":true},"replaceWith":""}]},
    {"id":"ira_other_stockholders_condition","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Other IRA stockholders closing condition","marker":"[and the other stockholders of the Company named as parties thereto]","trigger":{"field":"include_other_ira_stockholders","equals":true},"replaceWith":""}]},
    {"id":"single_closing_cross_references","type":"checkbox","standalone":true,"markerless":true,"inline":true,"options":[{"label":"Retain Initial Closing cross-references for multiple closings","marker":"Initial Closing","trigger":{"field":"closing_type","equals":"additional"},"replaceWith":"Closing"}]}
  ]
}
