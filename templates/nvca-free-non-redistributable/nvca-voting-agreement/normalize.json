{
  "paragraph_rules": [
    {
      "id": "resolve-requisite-holders-percentage",
      "section_heading": "Definitions",
      "ignore_heading": true,
      "paragraph_contains": "“Requisite Holders” means the holders of",
      "replacements": {
        "[at least [___]%/a majority]": "{requisite_holders_text}"
      },
      "expected_min_matches": 1
    },
    {
      "id": "state-five-seat-board-and-closing-vacancy",
      "section_heading": "Board Composition",
      "paragraph_contains": "the following persons shall be elected to the Board:",
      "replacements": {
        "the following persons shall be elected to the Board:": "the following persons shall be elected to the Board, which shall initially have {board_size} authorized seats, {vacant_board_seats_at_closing} of which shall remain vacant at the Closing:"
      },
      "expected_min_matches": 1
    },
    {
      "id": "unwrap-preferred-director-share-count-election",
