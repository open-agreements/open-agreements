      "paragraph_contains": "As a Preferred Director",
      "replacements": {
        "[As a Preferred Director, [Example 1:": "As a Preferred Director,",
        ";]]": ";"
      },
      "trim_unmatched_trailing_bracket": true,
      "expected_min_matches": 1
    },
    {
      "id": "unwrap-common-director-qualified-key-holder-election",
      "section_heading": "Board Composition",
      "paragraph_contains": "As a Common Director",
