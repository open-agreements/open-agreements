{
  "paragraph_rules": [
    {
      "id": "include-organizational-document-recitals",
      "section_heading": "INDEMNIFICATION AGREEMENT",
      "ignore_heading": true,
      "paragraph_contains": "require indemnification of the officers and directors",
      "replacements": {"[The Bylaws and Certificate of Incorporation":"The Bylaws and Certificate of Incorporation", "Company.]":"Company."},
      "expected_min_matches": 1
    },
    {
      "id": "include-fund-indemnitor-primacy",
      "section_heading": "Non-Exclusivity",
      "ignore_heading": true,
      "paragraph_contains": "indemnitor of first resort",
      "replacements": {"[The Company":"The Company", "Section 8(c).]":"Section 8(c)."},
      "expected_min_matches": 1
    },
    {
      "id": "include-successor-survival",
      "section_heading": "Duration of Agreement",
      "ignore_heading": true,
      "paragraph_contains": "successors (including any direct or indirect successor",
      "replacements": {"[This Agreement":"This Agreement", "representatives.]":"representatives."},
      "expected_min_matches": 1
    },
    {
      "id": "include-payment-taxes",
      "section_heading": "Definitions",
      "ignore_heading": true,
      "paragraph_contains": "federal, state, local or foreign taxes imposed",
      "replacements": {"[and any federal":"and any federal", "this Agreement]":"this Agreement"},
      "expected_min_matches": 1
    },
    {
      "id": "include-appointing-stockholder-severability",
      "section_heading": "Severability",
      "ignore_heading": true,
      "paragraph_contains": "as to either Indemnitee or Appointing Stockholder",
      "replacements": {"[Further,":"Further,", "the other.]":"the other.", "[and Appointing Stockholder]":"and Appointing Stockholder"},
      "expected_min_matches": 1
    },
    {
      "id": "include-process-agent",
      "section_heading": "Governing Law and Consent to Jurisdiction",
      "ignore_heading": true,
      "paragraph_contains": "agent for acceptance of legal process",
      "replacements": {"[(iii)":"(iii)", "State of Delaware,]":"State of Delaware,"},
      "expected_min_matches": 1
    },
    {
      "id": "repair-counterparts-duplication",
      "section_heading": "Counterparts",
      "ignore_heading": true,
      "paragraph_contains": "one and the same the same instrument",
      "replacements": {"one and the same the same instrument":"one and the same instrument"},
      "expected_min_matches": 1
    },
    {
      "id": "remove-duration-drafting-carrier",
      "section_heading": "Duration of Agreement",
      "ignore_heading": true,
      "paragraph_contains": "consider extending for several years",
      "replacements": {" [consider extending for several years after term of service, even if claim has not yet been paid]":""},
      "expected_min_matches": 1
    },
    {
      "id": "remove-embedded-section-nine-comment",
      "section_heading": "Exception to Right of Indemnification",
      "ignore_heading": true,
      "paragraph_contains": "This provision is designed to prevent the indemnitee",
      "replacements": {"[Comment:  This provision is designed to prevent the indemnitee from being indemnified for actions brought by the indemnitee except as otherwise provided. as well as for liability under Section 16(b) of the 1934 Act, for certain reimbursements of the Company by Indemnitee and where payment has already been made under an insurance policy.]":""},
      "expected_min_matches": 1
    },
    {
      "id": "remove-embedded-process-agent-note",
      "section_heading": "Governing Law and Consent to Jurisdiction",
      "ignore_heading": true,
      "paragraph_contains": "Delaware-incorporated Company is already subject",
      "replacements": {" [NOTE: as the Delaware-incorporated Company is already subject to service of process in Delaware, this really only applies to the individual director.]":""},
      "expected_min_matches": 1
    }
  ]
}
