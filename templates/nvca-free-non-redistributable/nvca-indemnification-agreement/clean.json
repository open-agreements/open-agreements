{
  "removeFootnotes": false,
  "removeEmptyLeadingParagraphs": true,
  "removeParagraphPatterns": [
    "^Comment:",
    "^NOTE:",
    "^The following additional exception can be added",
    "^\\[NOTE: as the Delaware-incorporated Company",
    "^_+Attention:_+$"
  ],
  "removeRanges": [
    {
      "start": "^MODEL INDEMNIFICATION AGREEMENT$",
      "end": "against their own directors and officers\\."
    },
    {
      "start": "^\\[Comment:",
      "end": "\\]\\s*$"
    }
  ]
}
