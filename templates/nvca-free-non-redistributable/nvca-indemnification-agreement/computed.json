{
  "version": "1.0",
  "max_passes": 2,
  "rules": [
    {
      "id": "role-scope-directors",
      "description": "Render director-only role carriers grammatically.",
      "when_all": [{ "field": "indemnitee_role_scope", "op": "eq", "value": "directors" }],
      "set_fill": {
        "indemnitee_role_scope_plural": "directors",
        "indemnitee_role_scope_singular": "a director"
      }
    },
    {
      "id": "role-scope-officers",
      "description": "Render officer-only role carriers grammatically.",
      "when_all": [{ "field": "indemnitee_role_scope", "op": "eq", "value": "officers" }],
      "set_fill": {
        "indemnitee_role_scope_plural": "officers",
        "indemnitee_role_scope_singular": "an officer"
      }
    },
    {
      "id": "role-scope-directors-or-officers",
      "description": "Render the combined director/officer role carriers with their required conjunction.",
      "when_all": [{ "field": "indemnitee_role_scope", "op": "eq", "value": "directors_or_officers" }],
      "set_fill": {
        "indemnitee_role_scope_plural": "directors or officers",
        "indemnitee_role_scope_singular": "an officer or director"
      }
    }
  ]
}
