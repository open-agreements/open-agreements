namespace org.openagreements.nvca.nvcarofrcosaleagreement@1.0.0

import org.accordproject.contract.Contract from https://models.accordproject.org/accordproject/contract.cto

enum Competitor_exclusion_modeType {
  o none
  o named
}

/**
 * NVCA Model Right of First Refusal and Co-Sale Agreement
 *
 * Right of first refusal and co-sale agreement for venture financings,
 * restricting transfer of founder shares and providing investor co-sale
 * rights.
 * Source: https://nvca.org/wp-content/uploads/2025/10/NVCA-Model-ROFRA-10-1-2025.docx
 */

asset NvcaRofrCoSaleAgreement extends Contract {
  o String company_name
  o String investor_name
  o String key_holder_name
  o String company_counsel
  o String counsel_cc default=""
  o String amended_restated_upper default=""
  o String amended_restated default=""
  o String judicial_district default="District of Delaware"
  o String state_of_incorporation default="Delaware"
  o String business_description
  o String signature_page_marker default="Signature Page Follows"
  o String effective_date
  o String specify_percentage
  o String rofr_response_days default="45"
  o String key_holders_label default="Key Holders"
  o String series_designation default=""
  o String par_value default="0.0001"
  o Competitor_exclusion_modeType competitor_exclusion_mode default="none"
  o String excluded_competitor_name default=""
  o String investor_minimum_shares optional
  o String permitted_transfer_percentage optional
  o String key_holder_consent_threshold_percentage optional
  o String permitted_transferee_minimum_shares optional
  o String investor_minimum_shares_display default=""
  o String permitted_transfer_percentage_display default=""
  o String key_holder_consent_threshold_percentage_display default=""
  o String permitted_transferee_minimum_shares_display default=""
}
